# Copy to .env.local for local development. Never commit real values.
# In Vercel, set these under Project → Settings → Environment Variables.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Either the new publishable key or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the WhatsApp webhook to store events. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- WhatsApp Cloud API (optional) ---
# WHATSAPP_APP_SECRET is required for the webhook: without it every POST is rejected (503).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- AI assistant (optional; OpenAI first, then local Ollama) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# --- Error reporting (optional) ---
# Server errors are always logged as JSON lines. If set, each one is also POSTed here
# (Slack incoming webhook, log drain, etc.). Headers/query strings are never included.
ERROR_WEBHOOK_URL=
